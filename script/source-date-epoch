#!/bin/bash

# Exit early
# See: https://www.gnu.org/savannah-checkouts/gnu/bash/manual/bash.html#The-Set-Builtin
set -e

# About:
#
# Prints a commit's date, as the seconds-since-epoch value SOURCE_DATE_EPOCH
# takes. Every build input has to be a function of the source, timestamps
# included, and the commit date is the one clock a third party rebuilding that
# commit also has.
#
# Anything other than a number is a failure rather than empty output. buildx
# reads an empty SOURCE_DATE_EPOCH as unset, `rewrite-timestamp` then rewrites
# nothing, and the image carries build times while everything still reports
# success.
#
# Usage:
#
# script/source-date-epoch [<ref>]

# Run from the repository root whatever the caller's directory is: `git show`
# resolves its path against the root, and `git log` needs to be inside the repo
# at all.
here=$(cd "$(dirname "$0")" && pwd)
cd "$(git -C "$here" rev-parse --show-toplevel)"

ref="${1-HEAD}"

# `${1-HEAD}` and not `${1:-HEAD}`: an argument that is present but empty is a
# caller whose own lookup failed, and defaulting that to HEAD answers a question
# nobody asked - with the current checkout's commit, which looks entirely
# plausible and is wrong.
if [[ -z $ref ]]; then
	echo "empty ref" >&2
	exit 2
fi

epoch=$(git log -1 --pretty=%ct "$ref")

case $epoch in
'' | *[!0-9]*)
	echo "no commit date for ${ref}: '${epoch}'" >&2
	exit 1
	;;
esac

echo "$epoch"
