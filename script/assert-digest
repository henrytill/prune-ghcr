#!/bin/bash

# Exit early
# See: https://www.gnu.org/savannah-checkouts/gnu/bash/manual/bash.html#The-Set-Builtin
set -e

# About:
#
# Fails unless every digest given is the same digest. Takes digests rather than
# places to find them, so that one comparison covers an OCI layout against a
# pushed image, a build against a rebuild, or a rebuild against what action.yml
# pins - see script/layout-digest for turning a layout into one of these.
#
# Anything that is not a full digest fails too. `sha256:[0-9a-f]*` would accept
# a bare `sha256:`, and two of those compare equal, which is how a check quietly
# stops checking.
#
# What is being compared is the caller's to say: this reports which values
# differed, not what that means.
#
# Usage:
#
# script/assert-digest <digest> <digest>...

if [[ $# -lt 2 ]]; then
	echo "usage: script/assert-digest <digest> <digest>..." >&2
	exit 2
fi

expected="$1"

for digest in "$@"; do
	if [[ ! $digest =~ ^sha256:[0-9a-f]{64}$ ]]; then
		echo "not a digest: '${digest}'" >&2
		exit 1
	fi

	if [[ $digest != "$expected" ]]; then
		echo "digests differ: ${expected} and ${digest}" >&2
		exit 1
	fi
done

echo "$expected"
