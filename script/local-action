#!/bin/bash

# Runs the action locally against a .env file, the way a workflow would.
#
# This replaces @github/local-action, which was dropped: it was the only path
# to a vulnerable undici with no patched version in range, and it pulled a
# large dependency tree for a script we rarely run.
#
# Usage:
#
# script/local-action [env-file]

set -euo pipefail

env_file="${1:-.env}"

if [ ! -f "$env_file" ]; then
	echo "No $env_file found. Copy .env.example to .env and fill it in." >&2
	exit 1
fi

# The action runs from the bundle, so it has to be current.
npm run package

# A runner consumes ::add-mask:: commands and masks the value everywhere. A
# terminal does not, so the line would print the token in the clear; drop it.
# pipefail keeps the exit code of node rather than sed.
node --env-file="$env_file" dist/index.js | sed '/^::add-mask::/d'
