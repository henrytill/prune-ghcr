# dotenv-linter:off IncorrectDelimiter

# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# Enable/disable step debug logging (default: `false`). For local debugging, it
# may be useful to set it to `true`.
ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs should follow `INPUT_<name>` format (case-sensitive).
# Hyphens should not be converted to underscores!

# PAT with delete:packages (classic) or read+write Packages (fine-grained).
INPUT_TOKEN=

# Owner of the package.
INPUT_OWNER=

# Container package name.
INPUT_PACKAGE=

# Skip versions younger than this.
INPUT_MIN-AGE-HOURS=0

# Start with a dry run: it reports what would be deleted without deleting it.
INPUT_DRY-RUN=true

# GitHub Actions default environment variables. These are set for every run of a
# workflow and can be used in your actions. Setting the value here will override
# any value set by the local-action tool.
# https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables

# CI="true"
# GITHUB_API_URL=""
# GITHUB_REPOSITORY=""
# GITHUB_REPOSITORY_OWNER=""
